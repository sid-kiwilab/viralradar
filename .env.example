# Copy to `.env.local` after `npx convex dev` (Next.js reads `.env.local`; repo-root `.env` also works).
# LLM + Browser API secrets for Convex: `npx convex env set` when actions run in the cloud.

NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment

# Convex deployment (`npx convex env set` — never commit real values):
# OPENROUTER_API_KEY=sk-or-REPLACE

# Bright Data Browser API (Playwright) — from Web Access → Browser API → Copy command
# BRIGHTDATA_BROWSER_WSS=wss://brd-customer-XXX-zone-scraping_browser1:ZONE_PASSWORD@brd.superproxy.io:9222
# Or split:
# BRIGHTDATA_BROWSER_USERNAME=brd-customer-XXX-zone-scraping_browser1
# BRIGHTDATA_BROWSER_PASSWORD=ZONE_PASSWORD_FROM_COPY_COMMAND

# Optional: account API key (MCP/CLI), not always the same as Browser zone password
# BRIGHTDATA_API_KEY=REPLACE

# Legacy residential proxy path (if not using Browser API):
# BRIGHTDATA_USERNAME=REPLACE
# BRIGHTDATA_PASSWORD=REPLACE
# BRIGHTDATA_HOST=brd.superproxy.io
# BRIGHTDATA_PORT=22225
# BRIGHTDATA_ZONE=residential

# Vercel production (when ready)
# CONVEX_DEPLOY_KEY=
